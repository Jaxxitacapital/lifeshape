    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
    xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
    xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#"
    xmlns:stRef="http://ns.adobe.com/xap/1.0/sType/ResourceRef#"
   xmp:CreatorTool="Adobe Photoshop CC 2018 (Windows)"
   xmp:CreateDate="2023-03-31T05:53:33+03:00"
   xmp:ModifyDate="2024-07-06T11:00:39-03:00"
   xmp:MetadataDate="2024-07-06T11:00:39-03:00"
   dc:format="image/jpeg"
   photoshop:ColorMode="4"
   xmpMM:InstanceID="xmp.iid:24d15c2a-baa8-4819-9ce6-6d3b23e9cbf4"
   xmpMM:DocumentID="adobe:docid:photoshop:98967445-ad75-b84c-bb4d-9dd221cfedf7"
   xmpMM:OriginalDocumentID="xmp.did:b489da95-fda9-704b-929d-d40dda2d5ca6">
   <photoshop:TextLayers>
    <rdf:Bag>
     <rdf:li
      photoshop:LayerName="Vladimir Savchuk"
      photoshop:LayerText="Vladimir Savchuk"/>
     <rdf:li
      photoshop:LayerName="HOST THE HOLY GHOST"
      photoshop:LayerText="HOST THE HOLY GHOST"/>
     <rdf:li
      photoshop:LayerName="Vladimir Savchuk"
      photoshop:LayerText="Vladimir Savchuk"/>
     <rdf:li
      photoshop:LayerName="HOST THE HOLY GHOST"
      photoshop:LayerText="HOST THE HOLY GHOST"/>
     <rdf:li
      photoshop:LayerName="Vladimir Savchuk"
      photoshop:LayerText="Vladimir Savchuk"/>
     <rdf:li
      photoshop:LayerName="HOST THE HOLY GHOST"
      photoshop:LayerText="HOST THE HOLY GHOST"/>
     <rdf:li
      photoshop:LayerName="Ghost"
      photoshop:LayerText="Ghost"/>
     <rdf:li
      photoshop:LayerName="Holy"
      photoshop:LayerText="Holy"/>
     <rdf:li
      photoshop:LayerName="the"
      photoshop:LayerText="the"/>
     <rdf:li
      photoshop:LayerName="Host"
      photoshop:LayerText="Host"/>
     <rdf:li
      photoshop:LayerName="Host"
      photoshop:LayerText="Host"/>
     <rdf:li
      photoshop:LayerName="Foreword by David Diga HernÃ¡ndez"
      photoshop:LayerText="Foreword by David Diga HernÃ¡ndez"/>
     <rdf:li
      photoshop:LayerName="Vladimir Savchuk"
      photoshop:LayerText="Vladimir Savchuk"/>
     <rdf:li
      photoshop:LayerName="Copyright @2023 Vladimir Savchuk  All Rights Reserved  "
      photoshop:LayerText="Copyright @2023 Vladimir Savchuk  All Rights Reserved  "/>
     <rdf:li
      photoshop:LayerName="About the author part2"
      photoshop:LayerText="a sought-after speaker at conferences and conventions.  Vlad was born in Ukraine and raised in a Christian home. He immigrated to the USA at the age of 13 and became a youth pastor at the age of 16. He is married to his beautiful wife, Lana,  with whom he enjoys spending time and  doing ministry together."/>
     <rdf:li
      photoshop:LayerName="About the author part1"
      photoshop:LayerText="Vladimir Savchuk leads the HungryGen movement and pastors a multi-cultural church with a clear-cut focused vision to see the salvation of souls, healing, deliverance, and the raising up of young leaders. He leads the annual â€œRaised to Deliverâ€ conference which attracts thousands of people from all over the globe. He also leads an online school that offers free online courses on Biblical topics. Pastor Vlad is "/>
     <rdf:li
      photoshop:LayerName="Vladimir Savchuk leads the HungryGen  movement and pastors a mu"
      photoshop:LayerText="Vladimir Savchuk leads the HungryGen  movement and pastors a multi-cultural  church with a clear-cut focused vision to  see the salvation of souls, healing,  deliverance, and the raising up of young  leaders. He leads the annual  â€œRaised to Deliverâ€ conference, which  attracts thousands of people from all over  the globe. He also leads an online school  that offers free online courses on Biblical  topics. Pastor Vlad is a sought-after speaker  at conferences and conventions.  "/>
     <rdf:li
      photoshop:LayerName="All believers in Christ have a relationship with the Holy Spiri"
      photoshop:LayerText="All believers in Christ have a relationship with the Holy Spirit, but not all believers have intimacy with Him. The Holy Spirit was sent to lead you deeper into the knowledge of the truth and give you the strength to overcome trials and the power to reach this world.   In this book, Host the Holy Ghost, Pastor Vladimir Savchuk takes you on a journey through discovering communion with the Holy Spirit, which belongs to everyone, not just the spiritually elite.  You will learn how to:  â€¢ develop your relationship with the Holy Spirit.  â€¢ walk in true intimacy with Him. â€¢ cultivate the fruit of the Spirit in your life. â€¢ operate in His power and anointing. â€¢ identify the danger of appointing without anointing. â€¢ discern the true manifestations of the Spirit.  â€¢ and much more! "/>
     <rdf:li
      photoshop:LayerName="header"
      photoshop:LayerText="Your intimacy with the Holy Spirit is the key to boldness and boldness is the key to miracles."/>
     <rdf:li
      photoshop:LayerName="quote 2"
      photoshop:LayerText="â€œVlad is an emerging voice in this generation. This book will transform your understanding of the Holy Spirit and intimacy with Him.â€  â€” Jeremiah Johnson "/>
     <rdf:li
      photoshop:LayerName="quote 1"
      photoshop:LayerText="â€œWe cannot afford to live beyond or outside of Godâ€™s presence. This writing will fuel your faith for radical Spirit-filled living.â€ â€” Ryan LeStrange"/>
     <rdf:li
      photoshop:LayerName="barcode"
      photoshop:LayerText="ISBN 978-1-951201-27-2"/>
    </rdf:Bag>
   </photoshop:TextLayers>
   <photoshop:DocumentAncestors>
